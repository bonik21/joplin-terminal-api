JOPLIN_VERSION=3.7.1
JOPLIN_locale=en_GB
JOPLIN_dateFormat=DD/MM/YYYY
JOPLIN_timeFormat=HH:mm

# ==============================================================================
# Joplin Sync Target Options
# ==============================================================================
# Possible values:
#   0 : None (Disable sync)
#   2 : File system
#   3 : OneDrive
#   5 : Nextcloud
#   6 : WebDAV
#   7 : Dropbox
#   8 : S3 (Beta)
#   9 : Joplin Server (Beta)
#  10 : Joplin Cloud
#
# Note:
#   Required configuration options (e.g., sync.9.path, sync.5.username,
#   sync.6.url) vary depending on the selected sync.target.
#   Reference: https://joplinapp.org/help/apps/terminal/#commands
# ==============================================================================
JOPLIN_sync_target=9
JOPLIN_sync_9_path=https://selfhosted.joplinserver.url
JOPLIN_sync_9_username=myusername
JOPLIN_sync_9_password=mypw
#JOPLIN_sync_interval=300
#JOPLIN_sync_maxConcurrentConnections=5
#JOPLIN_sync_wipeOutFailSafe=true

#JOPLIN_notes_sortOrder_field=user_updated_time
#JOPLIN_notes_sortOrder_reverse=true
#JOPLIN_folders_sortOrder_field=title
#JOPLIN_uncompletedTodosOnTop=true
#JOPLIN_showCompletedTodos=true
#JOPLIN_trackLocation=true

#JOPLIN_markdown_plugin_softbreaks=false
#JOPLIN_markdown_plugin_typographer=false
#JOPLIN_net_proxyTimeout=1
#JOPLIN_revisionService_enabled=true
#JOPLIN_revisionService_ttlDays=90
#JOPLIN_layout_folderList_factor=1
#JOPLIN_layout_noteList_factor=1
#JOPLIN_layout_note_factor=2
